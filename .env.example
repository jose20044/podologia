# Copia este archivo a .env y rellena los valores.
# NO subas .env a GitHub.

PORT=3001
DB_NAME=podologia_db
DB_PASSWORD=cambia_esta_password

# Genera uno con: openssl rand -hex 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# Token secreto para crear cuentas de médico (cabecera x-setup-token)
SETUP_TOKEN=genera_otro_secreto

# Orígenes CORS permitidos en producción (coma-separados). Vacío = permitir todo.
# CORS_ORIGIN=https://tu-dominio.com

NODE_ENV=development
